# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
LumePort/SourceArt/**/*.png
LumePort/SourceArt/**/*.tga

# Binary Files
LumePort/Binaries/*
LumePort/Plugins/*/Binaries/*

# Builds
LumePort/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!LumePort/Build/*/
LumePort/Build/*/**
!LumePort/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!LumePort/Build/**/*.ico

# Built data for maps
LumePort/*_BuiltData.uasset

# Configuration files generated by the Editor
LumePort/Saved/*

# Compiled source files for the engine to use
LumePort/Intermediate/*
LumePort/Plugins/*/Intermediate/*

# Cache files for the editor to use
LumePort/DerivedDataCache/*
